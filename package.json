{
  "name": "hypershub-vscode",
  "displayName": "HypersHub",
  "description": "Configure HypersHub integrations (Claude Code, Codex, OpenCode) from VS Code",
  "version": "0.1.1",
  "publisher": "hypershub",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/hypershub-icon.webp",
  "activationEvents": [
    "onView:hypershubConfig",
    "onCommand:hypershub.configure",
    "onCommand:hypershub.configureIntegration",
    "onCommand:hypershub.testConnection",
    "onCommand:hypershub.selectModel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hypershub.configure",
        "title": "HypersHub: Global Configuration"
      },
      {
        "command": "hypershub.configureIntegration",
        "title": "HypersHub: Configure Integration"
      },
      {
        "command": "hypershub.testConnection",
        "title": "HypersHub: Test Connection"
      },
      {
        "command": "hypershub.selectModel",
        "title": "HypersHub: Select Default Model"
      },
      {
        "command": "hypershub.refreshStatus",
        "title": "HypersHub: Refresh Status"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hypershub",
          "title": "HypersHub",
          "icon": "media/hypershub-icon.webp"
        }
      ]
    },
    "views": {
      "hypershub": [
        {
          "type": "tree",
          "id": "hypershubConfig",
          "name": "Configuration Status"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "hypershub.refreshStatus",
          "when": "view == hypershubConfig",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "hypershub.refreshStatus",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "HypersHub",
      "properties": {
        "hypershub.enableStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show HypersHub status in the status bar"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@vscode/test-electron": "^2.3.0",
    "typescript": "^5.3.0",
    "mocha": "^10.2.0",
    "@types/mocha": "^10.0.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hypershub/hypershub-vscode"
  },
  "bugs": {
    "url": "https://github.com/hypershub/hypershub-vscode/issues"
  },
  "homepage": "https://github.com/hypershub/hypershub-vscode#readme"
}
